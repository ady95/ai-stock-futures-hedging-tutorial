# 이 파일을 .env 로 복사한 뒤 본인 값으로 채웁니다. .env 는 절대 커밋하지 않습니다.
# 1~2장 합성 데이터 실습에는 API 키가 필요 없습니다.

# 한국투자증권(KIS) Open API — 모의투자
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_ACCOUNT_NO=
KIS_PAPER_ACCOUNT_PROD=01

# 한국투자증권(KIS) Open API — 실전 (시세 조회용. 이 책의 예제는 실전 주문을 하지 않습니다)
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
KIS_REAL_ACCOUNT_NO=
KIS_REAL_ACCOUNT_PROD=01

# KRX Open API (3-2) — 인증키 발급 후 서비스별 'API 이용신청' 승인이 따로 필요
# 필요한 서비스: 주식선물(유가) 일별매매정보, 주식선물(코스닥) 일별매매정보
KRX_API_KEY=

# 키움증권 REST API (선택 — 3장 교차검증 심화)
KIWOOM_PAPER_APP_KEY=
KIWOOM_PAPER_APP_SECRET=
KIWOOM_PAPER_ACCOUNT_NO=
KIWOOM_REAL_APP_KEY=
KIWOOM_REAL_APP_SECRET=
KIWOOM_REAL_ACCOUNT_NO=
